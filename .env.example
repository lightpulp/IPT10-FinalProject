# Copy this file to .env and fill in the values.
# APP_DEBUG=true shows exception details in the browser. Use false in production.
APP_DEBUG=
# Base URL of the site, e.g. http://localhost:8000 or http://localhost/IPT10/BLF/public
# Leave blank to detect it automatically.
APP_URL=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=
# Optional. Free key from https://www.exchangerate-api.com. Blank uses the open-access endpoint.
EXCHANGE_RATE_API_KEY=
